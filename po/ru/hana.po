#: src/Components/AddFilesField.qml:16
msgctxt "@action:button"
msgid "Add files"
msgstr "Добавить файлы"

#: src/Components/AddFilesField.qml:25
msgctxt "@title:window"
msgid "Select files"
msgstr "Выбор файлов"

#: src/Components/AvoidDarkFramesField.qml:15
msgctxt "@option:check"
msgid "Avoid dark frames"
msgstr "Избегать тёмных кадров"

#: src/Components/AvoidDarkFramesField.qml:24
msgctxt "@info:tooltip"
msgid ""
"Checked: tries to avoid very dark frames by changing the time the thumbnail "
"is taken<br><b>Can be very slow</b><br><br>Unchecked: thumbnail is taken "
"regardless of its content"
msgstr ""
"Флажок установлен: программа пытается избегать очень тёмных кадров, сдвигая "
"момент снятия миниатюры<br><b>Может работать очень медленно</"
"b><br><br>Флажок снят: миниатюра снимается независимо от содержимого"

